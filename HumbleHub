                TweenService:Create(DropdownCard, TweenInfo.new(0.25), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
            end)

            return {
                Refresh = function(newOptions)
                    options = newOptions
                    local found = false
                    for _, opt in ipairs(options) do
                        if opt == selected then found = true; break end
                    end
                    if not found then
                        selected = options[1] or "Select..."
                        MainButton.Text = "  " .. ddText .. ": " .. selected
                        if callback then callback(selected) end
                    end
                    renderOptions(options)
                end
            }
        end

        return Tab
    end

    return Window
