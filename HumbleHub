        -- [ PATCHED DROPDOWN COMPONENT ]
        function Tab:CreateDropdown(ddText, options, default, callback)
            local selected = default or options[1] or "Select..."
            local expanded = false

            local DropdownCard = Instance.new("Frame")
            DropdownCard.Parent = ContentFrame
            DropdownCard.BackgroundColor3 = Theme.Card
            DropdownCard.Size = UDim2.new(1, 0, 0, 38)
            DropdownCard.ClipsDescendants = true

