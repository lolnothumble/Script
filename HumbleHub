local selectedWorld = "World 1"
local selectedLaneIndex = 1
local loopTeleport = false
local loopWait = 1

-- Dynamic lane options generator
local function getLaneOptions(worldName)
    local max = worldMaxLanes[worldName] or 0
    local opts = {}
    for i = 1, max do
        table.insert(opts, "Lane" .. i)
    end
    return opts
end

-- Helper Function: Target CFrame with strict enforcement
local function getTargetCFrame(worldName, laneIndex)
    local maxLanes = worldMaxLanes[worldName] or 0
    if maxLanes == 0 then return nil, nil, "World 3 is currently empty!" end
    
    if laneIndex > maxLanes then 
        return nil, nil, worldName .. " only allows up to Lane " .. maxLanes .. "!" 
    end

    local map = workspace:FindFirstChild("Map")
    if map then
        local targetFolder = map:FindFirstChild(worldName) or map
        local win = targetFolder:FindFirstChild("Win") or map:FindFirstChild("Win")
        if win then
            local lane = win:FindFirstChild("Lane" .. laneIndex)
            if lane and lane:FindFirstChild("WinPart") then
                return lane.WinPart.CFrame, lane.WinPart, nil
            end
        end
    end

    if worldCFrames[worldName] and worldCFrames[worldName][laneIndex] then
        return worldCFrames[worldName][laneIndex], nil, nil
    end

    return nil, nil, "Location not found for Lane " .. laneIndex
end

-- Teleport Execution
local function teleportToTarget()
    local char = game.Players.LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false, "Character not found" end

    local targetCFrame, actualPart, err = getTargetCFrame(selectedWorld, selectedLaneIndex)
    if err then return false, err end

    if targetCFrame then
        char.HumanoidRootPart.CFrame = targetCFrame
        if actualPart and firetouchinterest then
            firetouchinterest(char.HumanoidRootPart, actualPart, 0)
            task.wait(0.05)
            firetouchinterest(char.HumanoidRootPart, actualPart, 1)
        end
        return true, nil
    end
    return false, "Invalid CFrame"
end

