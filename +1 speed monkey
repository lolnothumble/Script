-- Checks if player level matches or exceeds the rebirth level requirement
local function canRebirth()
    local ready = false
    pcall(function()
        local progressLabel = LocalPlayer.PlayerGui.Main.UIs.Rebirth.Level.Progress
        if progressLabel and progressLabel:IsA("TextLabel") and progressLabel.Text ~= "" then
            local text = progressLabel.Text
            
            -- If format is "15/15" or "100 / 100"
            local curStr, reqStr = text:match("([%d%.]+)%s*/%s*([%d%.]+)")
            if curStr and reqStr then
                local currentVal = parseNumber(curStr)
                local requiredVal = parseNumber(reqStr)
                if currentVal >= requiredVal and requiredVal > 0 then
                    ready = true
                end
            else
                -- If format is "Level 15" or raw requirement number
                local reqLevel = parseNumber(text)
                local currentLevel = getPlayerLevel()
                if currentLevel >= reqLevel and reqLevel > 0 then
                    ready = true
                end
            end
        end
    end)
    return ready
end

-- Fire all TouchInterests inside a target instance to ensure complete bypass
local function fireAllTouchInterests(targetInstance)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetInstance then return end

    local targetPart = targetInstance:IsA("BasePart") and targetInstance or targetInstance:FindFirstChildWhichIsA("BasePart", true)
    if not targetPart then return end

    if firetouchinterest then
        for _, child in ipairs(targetInstance:GetDescendants()) do
            if child:IsA("TouchTransmitter") or child.Name == "TouchInterest" then
                firetouchinterest(hrp, targetPart, 0)
                firetouchinterest(hrp, targetPart, 1)
            end
        end
    end
end

-- Find all TouchInterests in a Stage's treadmill and step on them
local function stepOnTreadmill(stage)
    if not stage then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, descendant in ipairs(stage:GetDescendants()) do
        if descendant.Name == "TouchInterest" or descendant:IsA("TouchTransmitter") then
            local p = descendant.Parent
            if p and p:IsA("BasePart") then
                hrp.CFrame = p.CFrame + Vector3.new(0, 2.5, 0)
                hrp.AssemblyLinearVelocity = Vector3.zero
                if firetouchinterest then
                    firetouchinterest(hrp, p, 0)
                    firetouchinterest(hrp, p, 1)
                end
                break
            end
        end
    end
end

-- UI Button Safe Clicker for Equipping
local function clickGuiButton(btn)
    if not btn or not btn:IsA("GuiButton") then return end
    if getsenv and firesignal then
        firesignal(btn.MouseButton1Click)
        firesignal(btn.Activated)
    else
        for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do
            conn:Fire()
        end
        for _, conn in ipairs(getconnections(btn.Activated)) do
            conn:Fire()
        end
    end
end

-- Scans Upgrades Folder for Buttons 1 to 10
local function getAllSpeedUpgrades()
    local list = {}
    local upgradesFolder = Workspace:FindFirstChild("Map") 
        and Workspace.Map:FindFirstChild("World1") 
        and Workspace.Map.World1:FindFirstChild("Upgrades")
    
    if upgradesFolder then
        for i = 1, 10 do
            local btn = upgradesFolder:FindFirstChild("Button" .. i)
            if btn then
                local plusStep = btn:FindFirstChild("PlusStep")
                local bb = plusStep and plusStep:FindFirstChild("BillboardGui")
                
                local stepsLabel = bb and bb:FindFirstChild("Steps") and bb.Steps:FindFirstChild("TextLabel")
                local stepsAmount = (stepsLabel and stepsLabel:IsA("TextLabel")) and parseNumber(stepsLabel.Text) or i
                
                local reqLabel = bb and bb:FindFirstChild("Required")
                local reqWins = (reqLabel and reqLabel:IsA("TextLabel")) and parseNumber(reqLabel.Text) or 0

                table.insert(list, {
                    ButtonIndex = i,
                    Button = btn,
                    Steps = stepsAmount,
                    Cost = reqWins
                })
            end
        end
    end
    return list
end

-- ===== DYNAMIC SCANNERS =====

local function getAvailableWinStages()
    local list = {}
    winStagesMap = {}

    local stagesFolder = Workspace:FindFirstChild("Map") 
        and Workspace.Map:FindFirstChild("World1") 
        and Workspace.Map.World1:FindFirstChild("Stages")

    if stagesFolder then
        local rawStages = {}
        for _, stage in ipairs(stagesFolder:GetChildren()) do
            local num = tonumber(stage.Name:match("%d+"))
            if num then
                table.insert(rawStages, {
                    Stage = stage,
                    Number = num
                })
            end
        end

        table.sort(rawStages, function(a, b)
            return a.Number < b.Number
        end)

        for _, item in ipairs(rawStages) do
            local stage = item.Stage
            local stageNum = item.Number

            local recLevel = 0
            local stageWall = stage:FindFirstChild("StageWall")
            if stageWall then
                for _, d in ipairs(stageWall:GetDescendants()) do
                    if d.Name == "Recommended" and d:IsA("TextLabel") then
                        recLevel = parseNumber(d.Text)
                        break
                    end
                end
            end

            local winAmountText = "+0 Wins"
            local normalWin = stage:FindFirstChild("NormalWin")
            local winLabel = normalWin and normalWin:FindFirstChild("UI") 
                and normalWin.UI:FindFirstChild("BillboardGui") 
                and normalWin.UI.BillboardGui:FindFirstChild("TextLabel")

            if winLabel and winLabel:IsA("TextLabel") and winLabel.Text ~= "" then
                winAmountText = winLabel.Text
            end

            local winBtn = normalWin and normalWin:FindFirstChild("Button")
            local displayName = stage.Name .. " [" .. winAmountText .. "] [Req Lvl: " .. recLevel .. "]"

            winStagesMap[displayName] = {
                Stage = stage,
                StageName = stage.Name,
                Number = stageNum,
                RecLevel = recLevel,
                Button = winBtn
            }
            table.insert(list, displayName)
        end
    end

    if #list == 0 then
        for i = 1, 10 do
            local fallback = "Stage" .. i .. " [+" .. (i * 5) .. " Wins] [Req Lvl: " .. (i * 2) .. "]"
            winStagesMap[fallback] = {
                StageName = "Stage" .. i,
                Number = i,
                RecLevel = i * 2
            }
            table.insert(list, fallback)
        end
    end

    return list
end

