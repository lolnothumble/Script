-- HumbleScriptz Roblox Client Loader & Key UI (Auto-Save & UserId Edition)
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer or Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
local UserId = tostring(LocalPlayer.UserId) -- Binds key directly to the Roblox Account ID
local API_URL = "http://humblescriptz.x10.mx/api/verify.php"
local GET_KEY_URL = "http://humblescriptz.x10.mx/getkey.php?hwid=" .. UserId
local KEY_FILE = "HumbleKey.txt"

-- Functions for File System & Clipboard
local function getSavedKey()
    if isfile and isfile(KEY_FILE) and readfile then
        return readfile(KEY_FILE)
    end
    return nil
end

local function saveKey(key)
    if writefile then
        writefile(KEY_FILE, key)
    end
end

local function removeSavedKey()
    if delfile and isfile and isfile(KEY_FILE) then
        delfile(KEY_FILE)
    end
end

-- 1. Auto-Login Check (Skips UI if saved key is valid)
local savedKey = getSavedKey()
if savedKey and savedKey ~= "" then
    local success, response = pcall(function()
        return game:HttpGet(API_URL .. "?key=" .. savedKey .. "&hwid=" .. UserId .. "&app_id=" .. game.PlaceId)
    end)

    if success then
        local isJson, data = pcall(function() return HttpService:JSONDecode(response) end)
        if not (isJson and data.status == "error") then
            -- Valid Key: Silently execute script without opening UI
            loadstring(game:HttpGet("https://raw.githubusercontent.com/lolnothumble/Script/refs/heads/main/testonly"))()
            return
        else
            -- Expired or Invalid Key: Delete old saved key file
            removeSavedKey()
        end
    end
end

