-- Event Listeners
PasteBtn.MouseButton1Click:Connect(function()
    local getClip = getclipboard or fromclipboard
    if getClip then
        KeyBox.Text = getClip()
        StatusLabel.Text = "Pasted key from clipboard!"
        StatusLabel.TextColor3 = Color3.fromRGB(52, 211, 153)
    else
        StatusLabel.Text = "Clipboard not supported on your executor."
        StatusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
    end
end)

GetKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(GET_KEY_URL)
        StatusLabel.Text = "Key link copied to clipboard!"
        StatusLabel.TextColor3 = Color3.fromRGB(52, 211, 153)
    else
        StatusLabel.Text = "Copy failed. Open site manually."
        StatusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
    end
end)

VerifyBtn.MouseButton1Click:Connect(function()
    local key = KeyBox.Text
    if key == "" then
        StatusLabel.Text = "Please enter a key!"
        StatusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
        return
    end

    StatusLabel.Text = "Verifying..."
    StatusLabel.TextColor3 = Color3.fromRGB(251, 191, 36)

    local success, response = pcall(function()
        return game:HttpGet(API_URL .. "?key=" .. key .. "&hwid=" .. UserId .. "&app_id=" .. game.PlaceId)
    end)

    if success then
        local isJson, data = pcall(function() return HttpService:JSONDecode(response) end)
        if isJson and data.status == "error" then
            StatusLabel.Text = data.message or "Invalid Key!"
            StatusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
        else
            StatusLabel.Text = "Key Verified! Saving..."
            StatusLabel.TextColor3 = Color3.fromRGB(52, 211, 153)
            
            -- Save key locally for auto-login
            saveKey(key)
            
            task.wait(1)
            ScreenGui:Destroy()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/lolnothumble/Script/refs/heads/main/testonly"))()
        end
    else
        StatusLabel.Text = "Server error. Try again later."
        StatusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
    end
end)
