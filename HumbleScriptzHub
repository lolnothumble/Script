    --// Sidebar Navigation Container
    local Sidebar = Instance.new("ScrollingFrame")
    Sidebar.Parent = MainFrame
    Sidebar.Active = true
    Sidebar.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
