-- Anti-Bypass Guard (Prevents direct URL execution)
if not _G.HumbleSecureLoaded then
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer or Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
    if LocalPlayer then
        LocalPlayer:Kick("Unauthorized direct Execution. Use the Official Script Loader.")
    end
    return
end
_G.HumbleSecureLoaded = nil -- Clear the flag for safety
